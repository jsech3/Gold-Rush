<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.yourname.tpmjobhunter</string>

    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>$HOME/Desktop/Your Name/2025/Digital Projects/Programming/Job Searching/run_daily_job_hunter.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
      <key>Hour</key>
      <integer>8</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>$HOME/Desktop/Your Name/2025/Digital Projects/Programming/Job Searching/logs/job_hunter.out.log</string>
    <key>StandardErrorPath</key>
    <string>$HOME/Desktop/Your Name/2025/Digital Projects/Programming/Job Searching/logs/job_hunter.err.log</string>
  </dict>
</plist>
