# Gold Rush Configuration Template
# Copy this to config.env and fill in your details

# ============================================================================
# EMAIL SETTINGS
# ============================================================================

# Your Gmail address (where job alerts are sent and where you'll receive digests)
EMAIL_ADDRESS=your.email@gmail.com

# Gmail App Password (NOT your regular Gmail password)
# Get this from: https://myaccount.google.com/apppasswords
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ============================================================================
# JSEARCH API SETTINGS
# ============================================================================

# Your RapidAPI key for JSearch
# Copy from: Job Tracking Dashboard/.env (look for VITE_JSEARCH_API_KEY)
JSEARCH_API_KEY=your_rapidapi_key_here

# API Host (don't change this)
JSEARCH_API_HOST=jsearch.p.rapidapi.com

# ============================================================================
# JOB SEARCH PREFERENCES
# ============================================================================

# Target job titles (comma-separated, no quotes)
TARGET_TITLES=Technical Product Manager,Product Manager - Data,Product Manager - Analytics,Senior Product Analyst,Data Product Manager

# Target locations (comma-separated, no quotes)
TARGET_LOCATIONS=San Francisco,Remote,Bay Area,Palo Alto,Mountain View

# Minimum acceptable salary (in USD)
MIN_SALARY=100000

# Preferred salary (jobs above this get bonus points)
PREFERRED_SALARY=120000

# ============================================================================
# NOTIFICATION SETTINGS
# ============================================================================

# Send daily digest email? (true/false)
SEND_DAILY_DIGEST=true

# Send immediate email for platinum jobs (90+ score)? (true/false)
SEND_IMMEDIATE_PLATINUM=true

# Time to send daily digest (24-hour format, HH:MM)
DIGEST_TIME=07:00

# ============================================================================
# API USAGE LIMITS
# ============================================================================

# Maximum JSearch API calls per day (free tier = 200/month, so ~6/day is safe)
MAX_JSEARCH_CALLS_PER_DAY=6

# Enable parsing of email job alerts? (true/false)
ENABLE_EMAIL_PARSING=true

# ============================================================================
# COMPANY PREFERENCES
# ============================================================================

# Preferred companies (comma-separated, get bonus points in scoring)
PREFERRED_COMPANIES=Stripe,Figma,Notion,Databricks,Snowflake,Retool,Airtable,Linear,Vercel,Ramp,Plaid,Aleo,Anthropic

# Companies to avoid (comma-separated, will be filtered out)
# Leave empty if you don't want to filter any companies
AVOID_COMPANIES=
